  \vspace{2pt}\footnotesize
  \textbf{The system uses no relational database.} The ledger is the store of
  record for trust, and its integrity is cryptographic (SHA-256 chain + Merkle
  root) rather than referential; the JSONL recording is the durable evidence log;
  configuration is YAML.
\end{frame}

