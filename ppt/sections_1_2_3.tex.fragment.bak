% ---------------------------------------------------------------- SECTION 1
\begin{frame}{1. Software Architecture \& Module Design}
  \framesubtitle{Rubric: UML Diagrams, DB Schema, APIs, Module Interaction \& Deployment (5 Marks)}
  \begin{columns}[T]
    \begin{column}{0.40\textwidth}
      \scriptsize
      \textbf{Five layers, one OS process.}\\[2pt]
      The controller is a single os-ken OpenFlow 1.3 application; the trust
      engine and the ledger are libraries it calls in-process, not services.
      \begin{itemize}\itemsep1pt
        \item \textbf{L5} dashboard, 19 evaluation tools, control arm
        \item \textbf{L4} northbound REST + SSE on :8081
        \item \textbf{L3} \texttt{trust\_balancer.py} for routing, detection and enforcement
        \item \textbf{L2} trust calculator, UCB1 optimiser, PRESENT-80 auth, ledger
        \item \textbf{L1} Mininet: 1 core + 8 edge switches, 8 servers, 40 IoT
      \end{itemize}
      \textbf{Design rule:} the request path \emph{writes} evidence into
      \texttt{TrustState}; the 1\,s control loop \emph{reads} decisions out of it.
    \end{column}
    \begin{column}{0.60\textwidth}
      \includegraphics[width=\textwidth,height=0.72\textheight,keepaspectratio]{figures/fig1_software_architecture.png}
    \end{column}
  \end{columns}
\end{frame}

